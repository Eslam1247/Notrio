JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-too
PUBLIC_URL=http://localhost:5173

# Optional: Google Sign-In (leave empty to disable)
GOOGLE_CLIENT_ID=

# Optional: PostgreSQL connection string from your host (Railway, Render, Supabase, Neon...).
# Leave empty to keep using the local db.json file for development.
DATABASE_URL=
# Most hosted Postgres providers need SSL; leave default. Set to "false" only for a local Postgres without SSL.
DATABASE_SSL=

# Optional: transactional email via Resend (resend.com). Leave both empty to disable emails entirely.
RESEND_API_KEY=
RESEND_FROM=Notrio <onboarding@yourdomain.com>
